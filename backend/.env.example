# 复制为 .env 并按需修改。生产环境务必修改 SECRET_KEY 和管理员密码！
APP_NAME=虚拟黄金交易系统
VERSION=1.0.0
DEBUG=false

# 安全密钥：用 python -c "import secrets;print(secrets.token_hex(32))" 生成
SECRET_KEY=CHANGE-ME-TO-A-RANDOM-64-CHAR-STRING
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 数据库（SQLite 文件路径）
DATABASE_URL=sqlite:///./data/gold.db

# 金价抓取间隔（秒）
PRICE_FETCH_INTERVAL_SECONDS=30
SINA_GOLD_SYMBOL=gds_AU9999

# 初始管理员（仅首次启动创建，登录后请改密码）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
